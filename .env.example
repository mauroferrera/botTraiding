# Copia este archivo a ".env" y completa los valores.
# Orden flow del futuro 6E (CME) vía Databento
DATABENTO_API_KEY="tu-clave"

# Claves del agente IA (al menos una). Varias claves GEMINI permiten
# rotación y backoff ante límites de rate (429).
# OPENAI_API_KEY="tu-clave"
# ANTHROPIC_API_KEY="tu-clave"
GEMINI_API_KEY="tu-clave"
GEMINI_API_KEY_2="tu-clave"
GEMINI_API_KEY_3="tu-clave"

# Opcional: sobreescribe el directorio de exportaciones de MQL5\Files
# del indicador AI Chart Assistant.
# MT5_FILES_DIR="C:\ruta\a\MetaQuotes\Terminal\<HASH>\MQL5\Files"